// PIPELINES
{
    "name": "PL_001_Master_SharePointToBlobStorage",
    "properties": {
        "activities": [
            {
                "name": "Convert Excel To Parquet",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "SharePoint To Blob storage",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_001_Transformation_ConvertExcelToParquet",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "DatePath": {
                            "value": "@variables('DatePath')",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "Current Date",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "DatePath",
                    "value": {
                        "value": "@concat(\n  formatDateTime(utcNow(), 'yyyy'),\n  '/',\n  formatDateTime(utcNow(), 'MMMM'),\n  '/',\n  formatDateTime(utcNow(), 'dd')\n)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SharePoint To Blob storage",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "Current Date",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_001_Ingestion_SharePointToBlob",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "DatePath": {
                            "value": "@variables('DatePath')",
                            "type": "Expression"
                        }
                    }
                }
            }
        ],
        "variables": {
            "DatePath": {
                "type": "String"
            },
            "DriveId": {
                "type": "String"
            }
        },
        "folder": {
            "name": "Master"
        },
        "annotations": []
    }
}

{
    "name": "PL_001_Ingestion_SharePointToBlob",
    "properties": {
        "activities": [
            {
                "name": "Get TenantId",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "url": {
                        "value": "https://@{pipeline().parameters.KeyVaultName}.vault.azure.net/secrets/@{pipeline().parameters.TenantId}/?api-version=7.0",
                        "type": "Expression"
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://vault.azure.net"
                    }
                }
            },
            {
                "name": "Get ClientId",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "url": {
                        "value": "https://@{pipeline().parameters.KeyVaultName}.vault.azure.net/secrets/@{pipeline().parameters.ClientId}/?api-version=7.0",
                        "type": "Expression"
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://vault.azure.net"
                    }
                }
            },
            {
                "name": "Get Secret",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "url": {
                        "value": "https://@{pipeline().parameters.KeyVaultName}.vault.azure.net/secrets/@{pipeline().parameters.ClientSecret}/?api-version=7.0",
                        "type": "Expression"
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://vault.azure.net"
                    }
                }
            },
            {
                "name": "Get AAD Token",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "Get TenantId",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "Get ClientId",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "Get Secret",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "url": {
                        "value": "https://login.microsoftonline.com/@{activity('Get TenantId').output.value}/oauth2/v2.0/token",
                        "type": "Expression"
                    },
                    "body": {
                        "value": "client_id=@{activity('Get ClientId').output.value}\n&client_secret=@{activity('Get Secret').output.value}\n&grant_type=client_credentials\n&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Sharepoint Get Site Id",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "Get AAD Token",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Authorization": {
                            "value": "Bearer @{activity('Get AAD Token').output.access_token}",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "https://graph.microsoft.com/v1.0/sites/@{pipeline().parameters.SharepointDomainName}.sharepoint.com:/sites/@{pipeline().parameters.SharepointSite}:/drives",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Sharepoint Get List Items",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "Sharepoint Get Site Id",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "Sharepoint Full Path",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Authorization": {
                            "value": "Bearer @{activity('Get AAD Token').output.access_token}",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "https://graph.microsoft.com/v1.0/drives/@{activity('Sharepoint Get Site Id').output.value[0].id}/root:/@{variables('SharePointFullPath')}:/children",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Loop Sharepoint Files",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Sharepoint Get List Items",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "Blob Storage Full Path",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Sharepoint Get List Items').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "Sharepoint Files To Blob Storage",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "HttpReadSettings",
                                        "requestMethod": "GET"
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_File_SharePoint_HTTP",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "RelativeURL": {
                                            "value": "@replace(item()['@microsoft.graph.downloadUrl'], 'https://gointegreat.sharepoint.com', '')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_File_Binary_BlobStorage",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Container": {
                                            "value": "@pipeline().parameters.BlobContainer",
                                            "type": "Expression"
                                        },
                                        "FolderPath": {
                                            "value": "@variables('BlobFullPath')",
                                            "type": "Expression"
                                        },
                                        "FileName": {
                                            "value": "@item().name",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "Sharepoint Full Path",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "SharePointFullPath",
                    "value": {
                        "value": "@replace(pipeline().parameters.SharepointFolder, '{date_path}', pipeline().parameters.DatePath)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Blob Storage Full Path",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "BlobFullPath",
                    "value": {
                        "value": "@replace(pipeline().parameters.BlobFolderPath, '{date_path}', pipeline().parameters.DatePath)",
                        "type": "Expression"
                    }
                }
            }
        ],
        "parameters": {
            "KeyVaultName": {
                "type": "string",
                "defaultValue": "azkv-autotest"
            },
            "TenantId": {
                "type": "string",
                "defaultValue": "SharepointBasic-GIG-Tenant"
            },
            "ClientId": {
                "type": "string",
                "defaultValue": "SharepointBasic-GIG-AppId"
            },
            "ClientSecret": {
                "type": "string",
                "defaultValue": "SharePointBasic-GIG-Key"
            },
            "SharepointDomainName": {
                "type": "string",
                "defaultValue": "gointegreat"
            },
            "SharepointSite": {
                "type": "string",
                "defaultValue": "Intytest"
            },
            "SharepointFolder": {
                "type": "string",
                "defaultValue": "reports/{date_path}"
            },
            "DatePath": {
                "type": "string"
            },
            "BlobContainer": {
                "type": "string",
                "defaultValue": "raw"
            },
            "BlobFolderPath": {
                "type": "string",
                "defaultValue": "reports/{date_path}"
            }
        },
        "variables": {
            "SharePointFullPath": {
                "type": "String"
            },
            "BlobFullPath": {
                "type": "String"
            }
        },
        "folder": {
            "name": "Ingestion"
        },
        "annotations": []
    }
}

{
    "name": "PL_001_Transformation_ConvertExcelToParquet",
    "properties": {
        "activities": [
            {
                "name": "Get List Files",
                "type": "GetMetadata",
                "dependsOn": [
                    {
                        "activity": "Source Full Path",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "DS_File_Binary_BlobStorage",
                        "type": "DatasetReference",
                        "parameters": {
                            "Container": {
                                "value": "@pipeline().parameters.SourceContainer",
                                "type": "Expression"
                            },
                            "FolderPath": {
                                "value": "@variables('SourceFullPath')",
                                "type": "Expression"
                            },
                            "FileName": "/"
                        }
                    },
                    "fieldList": [
                        "childItems"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "BinaryReadSettings"
                    }
                }
            },
            {
                "name": "Loop Files",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Get List Files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "Destination Full Path",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Get List Files').output.childItems",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "Iteration Worksheets",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "policy": {
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_Transformation_Process_Excel_Files",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "SourceContainer": {
                                        "value": "@pipeline().parameters.SourceContainer",
                                        "type": "Expression"
                                    },
                                    "SourcePath": {
                                        "value": "@variables('SourceFullPath')",
                                        "type": "Expression"
                                    },
                                    "SourceFileName": {
                                        "value": "@item().name",
                                        "type": "Expression"
                                    },
                                    "DestinationContainer": {
                                        "value": "@pipeline().parameters.DestinationContainer",
                                        "type": "Expression"
                                    },
                                    "DestinationPath": {
                                        "value": "@variables('DestinationFullPath')",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Source Full Path",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "SourceFullPath",
                    "value": {
                        "value": "@replace(pipeline().parameters.SourceFolderPath, '{date_path}', pipeline().parameters.DatePath)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Destination Full Path",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "DestinationFullPath",
                    "value": {
                        "value": "@replace(pipeline().parameters.DestinationFolderPath, '{date_path}', pipeline().parameters.DatePath)",
                        "type": "Expression"
                    }
                }
            }
        ],
        "parameters": {
            "DatePath": {
                "type": "string",
                "defaultValue": "2026/January/05"
            },
            "SourceContainer": {
                "type": "string",
                "defaultValue": "raw"
            },
            "SourceFolderPath": {
                "type": "string",
                "defaultValue": "reports/{date_path}"
            },
            "DestinationContainer": {
                "type": "string",
                "defaultValue": "landing"
            },
            "DestinationFolderPath": {
                "type": "string",
                "defaultValue": "reports/{date_path}"
            }
        },
        "variables": {
            "mappingsArray": {
                "type": "Array"
            },
            "Mapping": {
                "type": "String"
            },
            "SourceFullPath": {
                "type": "String"
            },
            "DestinationFullPath": {
                "type": "String"
            }
        },
        "folder": {
            "name": "Transformation"
        },
        "annotations": []
    }
}

{
    "name": "PL_Transformation_Process_Excel_Files",
    "properties": {
        "activities": [
            {
                "name": "Read Excel Sheets",
                "type": "Script",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LinkSQL",
                    "type": "LinkedServiceReference",
                    "parameters": {
                        "Database": "GIGVELKPIDB"
                    }
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": {
                                "value": "SELECT\n    [excel_name]\n   ,[phase_name]\n   ,[sheet_name]\n   ,[table_range]\nFROM [velkpi].[excel_configuration]\nWHERE [excel_name] = '@{pipeline().parameters.SourceFileName}'",
                                "type": "Expression"
                            }
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
            },
            {
                "name": "If Not Empty List Sheets",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Read Excel Sheets",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@not(equals(length(activity('Read Excel Sheets').output.resultSets), 0))",
                        "type": "Expression"
                    },
                    "ifFalseActivities": [
                        {
                            "name": "Set Empty",
                            "type": "SetVariable",
                            "dependsOn": [],
                            "policy": {
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "variableName": "ListSheets",
                                "value": []
                            }
                        }
                    ],
                    "ifTrueActivities": [
                        {
                            "name": "Set List Sheets",
                            "type": "SetVariable",
                            "dependsOn": [],
                            "policy": {
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "variableName": "ListSheets",
                                "value": {
                                    "value": "@activity('Read Excel Sheets').output.resultSets[0].rows",
                                    "type": "Expression"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Iterate Sheets",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "If Not Empty List Sheets",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@variables('ListSheets')",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 5,
                    "activities": [
                        {
                            "name": "Read Column From Excel Sheet",
                            "type": "GetMetadata",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataset": {
                                    "referenceName": "DS_File_Excel_BlobStorage",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Container": {
                                            "value": "@pipeline().parameters.SourceContainer",
                                            "type": "Expression"
                                        },
                                        "FolderPath": {
                                            "value": "@pipeline().parameters.SourcePath",
                                            "type": "Expression"
                                        },
                                        "FileName": {
                                            "value": "@pipeline().parameters.SourceFileName",
                                            "type": "Expression"
                                        },
                                        "SheetName": {
                                            "value": "@item().sheet_name",
                                            "type": "Expression"
                                        },
                                        "Range": {
                                            "value": "@if(equals(item().table_range, null), 'A4', item().table_range)",
                                            "type": "Expression"
                                        }
                                    }
                                },
                                "fieldList": [
                                    "columnCount",
                                    "structure",
                                    "itemName"
                                ],
                                "storeSettings": {
                                    "type": "AzureBlobFSReadSettings",
                                    "recursive": true,
                                    "enablePartitionDiscovery": false
                                }
                            }
                        },
                        {
                            "name": "Convert Excel To Parquet",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Build Mapping",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "ExcelSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "value": "@json(activity('Build Mapping').output.pipelineReturnValue.mapping)",
                                    "type": "Expression"
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_File_Excel_BlobStorage",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Container": {
                                            "value": "@pipeline().parameters.SourceContainer",
                                            "type": "Expression"
                                        },
                                        "FolderPath": {
                                            "value": "@pipeline().parameters.SourcePath",
                                            "type": "Expression"
                                        },
                                        "FileName": {
                                            "value": "@pipeline().parameters.SourceFileName",
                                            "type": "Expression"
                                        },
                                        "SheetName": {
                                            "value": "@item().sheet_name",
                                            "type": "Expression"
                                        },
                                        "Range": {
                                            "value": "@if(equals(item().table_range, null), 'A4', item().table_range)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_File_Parquet_BlobStorage",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Container": {
                                            "value": "@pipeline().parameters.DestinationContainer",
                                            "type": "Expression"
                                        },
                                        "FolderPath": {
                                            "value": "@pipeline().parameters.DestinationPath",
                                            "type": "Expression"
                                        },
                                        "FileName": {
                                            "value": "@{replace(item().phase_name, ' ','_')}_@{replace(item().full_sheet_name, ' ', '_')}_@{formatDateTime(utcNow(), 'yyyyMMddHHmmss')}_@{guid('N')}.parquet",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Build Mapping",
                            "type": "ExecutePipeline",
                            "dependsOn": [
