{
    "name": "PL_Transformation_Process_Mapping",
    "properties": {
        "activities": [
            {
                "name": "Iterate Columns",
                "type": "ForEach",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@pipeline().parameters.ListColumns",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "Append Column",
                            "type": "AppendVariable",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "variableName": "mappingsArray",
                                "value": {
                                    "value": "@json(concat('{\n  \"source\": {\n    \"name\": \"', item().name,'\",\n    \"type\": \"', item().type,'\"\n  },\n  \"sink\": {\n    \"name\": \"', replace(item().name, ' ', ''), '\",\n    \"type\": \"String\"\n  }\n}'))",
                                    "type": "Expression"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Return Mapping",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "Iterate Columns",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "pipelineReturnValue",
                    "value": [
                        {
                            "key": "mapping",
                            "value": {
                                "type": "Expression",
                                "content": "{\n    \"type\": \"TabularTranslator\",\n    \"mappings\": @{variables('mappingsArray')}\n}"
                            }
                        }
                    ],
                    "setSystemVariable": true
                }
            }
        ],
        "parameters": {
            "ListColumns": {
                "type": "array",
                "defaultValue": [
                    {
                        "name": "Fecha",
                        "type": "String"
                    },
                    {
                        "name": "Presión Aceite del Motor",
                        "type": "String"
                    },
                    {
                        "name": "Unidad",
                        "type": "String"
                    }
                ]
            }
        },
        "variables": {
            "mappingsArray": {
                "type": "Array",
                "defaultValue": []
            },
            "Mapping": {
                "type": "String"
            }
        },
        "folder": {
            "name": "Transformation/Process"
        },
        "annotations": []
    }
}


