{
	"name": "Task_DatasetRefresh",
	"properties": {
		"description": "Refresh PBI dataset",
		"activities": [
			{
				"name": "Get AAD Token",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get TenantId",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get ClientId",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get Secret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/x-www-form-urlencoded"
					},
					"url": {
						"value": "@concat('https://login.microsoftonline.com/',activity('Get TenantId').output.value,'/oauth2/token')",
						"type": "Expression"
					},
					"body": {
						"value": "@concat('grant_type=client_credentials&resource=https://analysis.windows.net/powerbi/api&client_id=',activity('Get ClientId').output.value,'&client_secret=',encodeUriComponent(activity('Get Secret').output.value))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get TenantId",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(pipeline().globalParameters.KeyVaultUri,'secrets/',pipeline().parameters.TenantId,'/?api-version=7.0')",
						"type": "Expression"
					},
					"body": {
						"simple": "body"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Get ClientId",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(pipeline().globalParameters.KeyVaultUri,'secrets/',pipeline().parameters.ClientId,'/?api-version=7.0')",
						"type": "Expression"
					},
					"body": {
						"simple": "body"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Get Secret",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(pipeline().globalParameters.KeyVaultUri,'secrets/',pipeline().parameters.ClientSecret,'/?api-version=7.0')",
						"type": "Expression"
					},
					"body": {
						"simple": "body"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Get Dataset Refresh Status",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get AAD Token",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"Authorization": {
							"value": "@concat(string(activity('Get AAD Token').output.token_type),' ',string(activity('Get AAD Token').output.access_token))",
							"type": "Expression"
						}
					},
					"url": {
						"value": "https://api.powerbi.com/v1.0/myorg/groups/@{pipeline().parameters.PBIAppWorkspaceId}/datasets/@{pipeline().parameters.PBIDatasetId}/refreshes?$top=1",
						"type": "Expression"
					},
					"body": {
						"Process": "Refresh"
					}
				}
			},
			{
				"name": "Refresh Status",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Dataset Refresh Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Get Dataset Refresh Status').output.value[0].status, 'Unknown'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Call Dataset Refresh",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"headers": {
									"Authorization": {
										"value": "@concat(string(activity('Get AAD Token').output.token_type),' ',string(activity('Get AAD Token').output.access_token))",
										"type": "Expression"
									}
								},
								"url": {
									"value": "@concat('https://api.powerbi.com/v1.0/myorg/groups/',pipeline().parameters.PBIAppWorkspaceId,'/datasets/',pipeline().parameters.PBIDatasetId,'/refreshes')",
									"type": "Expression"
								},
								"body": {
									"Process": "Refresh"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"TenantId": {
				"type": "string",
				"defaultValue": "opsbi-tenantid"
			},
			"ClientId": {
				"type": "string",
				"defaultValue": "opsbi-pbiclientid"
			},
			"ClientSecret": {
				"type": "string",
				"defaultValue": "opsbi-pbisecret"
			},
			"PBIAppWorkspaceId": {
				"type": "string",
				"defaultValue": "5d56cf12-09af-4763-a1e1-e983b244e8e4"
			},
			"PBIDatasetId": {
				"type": "string",
				"defaultValue": "4e38bdb0-68ac-49fb-b810-8610ef99dbb2"
			}
		},
		"variables": {
			"RefreshStatus": {
				"type": "String",
				"defaultValue": "Unknown"
			}
		},
		"folder": {
			"name": "Global/Task"
		},
		"annotations": [],
		"lastPublishTime": "2023-04-25T04:39:46Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}